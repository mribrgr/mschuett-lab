# Konfiguration der Node-App. Entweder in Plesk unter Node.js → „Benutzerdefinierte
# Umgebungsvariablen“ eintragen (empfohlen) oder als Datei config.env neben app.js ablegen.
# config.env liegt außerhalb von public_html und ist damit nicht öffentlich abrufbar.

# Postausgang: das Postfach kontakt@ auf dem KCS-Server (STARTTLS auf Port 587)
SMTP_HOST=a70.kcs-server.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kontakt@alibaba-dresden.de
SMTP_PASS=

# Absender und Empfänger der Benachrichtigung
MAIL_FROM="Website Ali Baba <kontakt@alibaba-dresden.de>"
MAIL_TO=alibaba-dresden@web.de

# Optional
# SUBJECT_PREFIX="[TEST] "
# PUBLIC_DIR=../public_html
# RATE_LIMIT_PER_IP=5            # Anfragen je IP in 10 Minuten
# ALLOWED_ORIGINS=https://alibaba-dresden.de,https://www.alibaba-dresden.de
